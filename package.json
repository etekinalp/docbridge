{
  "name": "docbridge",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "workers/*",
    "web"
  ],
  "scripts": {
    "build": "bun --filter './**' build",
    "test": "bun --filter './**' test",
    "lint": "bun --filter './**' lint",
    "dev:infra": "docker-compose up -d",
    "dev:infra:down": "docker-compose down"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}