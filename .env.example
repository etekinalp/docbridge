# System Environment
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL Database Connections
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Microservice Databases
USER_DB_NAME=user_db
PLATFORM_DB_NAME=platform_db
DOCBRIDGE_DB_NAME=docbridge_db

DATABASE_URL_USER=postgresql://postgres:postgres@localhost:5432/user_db
DATABASE_URL_PLATFORM=postgresql://postgres:postgres@localhost:5432/platform_db
DATABASE_URL_DOCBRIDGE=postgresql://postgres:postgres@localhost:5432/docbridge_db

# LocalStack AWS Emulation
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# S3 & SQS Resources
S3_STAGING_BUCKET=docbridge-staging-dev
SQS_JOB_FANOUT_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/docbridge-job-fanout-dev
SQS_TASK_DELIVERY_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/docbridge-task-delivery-dev
SQS_TASK_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/docbridge-task-dlq-dev
